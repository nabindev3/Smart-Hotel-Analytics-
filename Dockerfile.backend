# ════════════════════════════════════════════════════
#  Dockerfile.backend — FastAPI ML Backend
# ════════════════════════════════════════════════════
FROM python:3.11-slim

LABEL maintainer="Smart Hotel Analytics"
LABEL description="FastAPI backend serving ML models"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (layer-cached)
COPY requirements.prod.txt .
RUN pip install --no-cache-dir -r requirements.prod.txt

# Copy source code
COPY backend/   ./backend/
COPY src/       ./src/
COPY monitoring/ ./monitoring/

# Install the project so `backend` and `src` import as packages (this is what
# replaces the old per-file sys.path.insert hacks). Runtime deps are already
# installed above, so skip dependency resolution here.
COPY pyproject.toml ./
RUN pip install --no-cache-dir --no-deps -e .

# Model + data artifacts.
# ── DEFAULT (baked) ───────────────────────────────────────────────────────────
# The artifacts are baked into the image so the service runs with no external
# store. This is the current source of truth (the files are committed to git).
COPY data/      ./data/
COPY models/    ./models/
# ── LEAN mode (fetch at startup) ──────────────────────────────────────────────
# To stop baking artifacts in (review #24): delete the two COPY lines above,
# publish the artifacts with scripts/publish_artifacts.py, and set ONE of
# ARTIFACTS_BUNDLE_URL / ARTIFACTS_BASE_URL in the runtime env. backend/artifacts.py
# then downloads them on first use. See ARTIFACTS.md. Do this only after the
# store is live, or the deploy will start with no models.

# Non-root user for security
RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
